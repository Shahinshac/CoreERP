# Environment Mode ('production' or 'development')
ENVIRONMENT=production

# Database Connection (supports Supabase Transaction/Session pooler or standard Postgres)
# Example for Supabase transaction pooler (port 6543): postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/[DB-NAME]?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/erp_db

# Connection Pool Settings (Optimized for serverless / transaction poolers)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

# CORS Allowed Origins (comma-separated origins matching production frontend URL)
CORS_ORIGINS=https://your-app.vercel.app

# Auth & Secrets (Must be generated via `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production
AUTOMATION_KEY=replace-with-a-secure-random-secret-for-cron-in-production
RATE_LIMIT_ENABLED=true

# Cloudinary Storage Integration (Server-side only — never exposed to frontend)
# Configure either via CLOUDINARY_URL or via individual CLOUD_NAME / API_KEY / API_SECRET
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Brevo Transactional Email Integration (300 free emails/day tier HTTP API)
BREVO_API_KEY=your-brevo-api-key-here
EMAIL_FROM=billing@yourdomain.com
EMAIL_FROM_NAME=Your Store Name

# Seller GST & Billing Defaults
SELLER_NAME=My Retail Store Pvt Ltd
SELLER_GSTIN=27ABCDE1234F1Z5
SELLER_STATE=Maharashtra
SELLER_STATE_CODE=27
SELLER_ADDRESS=123 Commercial Hub, MG Road, Mumbai, Maharashtra 400001
SELLER_PHONE=+91 9876543210
SELLER_EMAIL=billing@myretailstore.com
SELLER_UPI_ID=retailstore@upi
SELLER_UPI_NAME=My Retail Store

# Supabase Integration (Legacy Storage Provider — dual-provider transition)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Cross-Origin Cookie Strategy:
# For decoupled frontend (e.g. Vercel) and backend (e.g. Render):
# Refresh cookies are set with:
# - Secure=True (requires HTTPS in production; modern browsers permit Secure cookies on http://localhost)
# - SameSite=None (permits cross-site fetch requests with credentials)
# - Path=/api (scopes the cookie strictly to backend API routes)
# - HttpOnly=True (prevents client-side script access to the token)
